="cm-line">    <span class="ͼ1f">category</span>: <span class="ͼ1d">"Combos"</span>,</div><div class="cm-line">    <span class="ͼ1f">items</span>: [</div><div class="cm-line">      [<span class="ͼ1d">"Philly Cheesesteak Fries Combo"</span>, <span class="ͼ1d">"$15"</span>, <span class="ͼ1d">"Philly cheesesteak flavor with fries, cheese, grilled onions, and Chef Daddy Ray's bold seasoning."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Chorizo Burger Combo"</span>, <span class="ͼ1d">"$15"</span>, <span class="ͼ1d">"Juicy burger stacked with chorizo, cheese, and house toppings."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"BBQ Chicken Sliders Combo"</span>, <span class="ͼ1d">"$12"</span>, <span class="ͼ1d">"Tender BBQ chicken sliders tossed in your choice of sauce."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Aubrie's Chicken Wings Combo"</span>, <span class="ͼ1d">"$13"</span>, <span class="ͼ1d">"Wings tossed in buffalo, blazing devil spit, garlic parm, BBQ, or ranch."</span>]</div><div class="cm-line">    ]</div><div class="cm-line">  },</div><div class="cm-line">  {</div><div class="cm-line">    <span class="ͼ1f">category</span>: <span class="ͼ1d">"Family Favorites"</span>,</div><div class="cm-line">    <span class="ͼ1f">items</span>: [</div><div class="cm-line">      [<span class="ͼ1d">"Kylee's Chicken Tacos"</span>, <span class="ͼ1d">"$10"</span>, <span class="ͼ1d">"Three chicken tacos with onion, cilantro, and sauce. Sub steak +$2."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Kylee's Steak Tacos"</span>, <span class="ͼ1d">"$13"</span>, <span class="ͼ1d">"Three steak tacos with onion, cilantro, and cilantro lime sour cream drizzle."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Kinsley's Double Loaded Mac &amp; Cheese"</span>, <span class="ͼ1d">"$10"</span>, <span class="ͼ1d">"Creamy mac loaded with protein and sauce drizzle. Add chicken +$3 or steak +$4."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Paytyn's Loaded Fries"</span>, <span class="ͼ1d">"$10"</span>, <span class="ͼ1d">"Fries with jalapeño cheese sauce and bacon. Add chicken +$2 or steak +$3."</span>]</div><div class="cm-line">    ]</div><div class="cm-line">  },</div><div class="cm-line">  {</div><div class="cm-line">    <span class="ͼ1f">category</span>: <span class="ͼ1d">"Sides &amp; Sweets"</span>,</div><div class="cm-line">    <span class="ͼ1f">items</span>: [</div><div class="cm-line">      [<span class="ͼ1d">"Fried Pickles &amp; Jalapeños"</span>, <span class="ͼ1d">"$10"</span>, <span class="ͼ1d">"Crispy, tangy, spicy, and made for dipping."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Jalapeño Cheese Sauce"</span>, <span class="ͼ1d">"+$2"</span>, <span class="ͼ1d">"Creamy house-made cheese sauce with jalapeño and garlic."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Chef Daddy Ray's BBQ Sauce Bottle"</span>, <span class="ͼ1d">"$12"</span>, <span class="ͼ1d">"Original BBQ, Honey BBQ, or Smoked BBQ."</span>],</div><div class="cm-line">      [<span class="ͼ1d">"Fried Oreos"</span>, <span class="ͼ1d">"$8"</span>, <span class="ͼ1d">"Golden, sweet, crispy dessert-truck favorite."</span>]</div><div class="cm-line">    ]</div><div class="cm-line">  }</div><div class="cm-line">];</div><div class="cm-line"><br></div><div class="cm-line"><span class="ͼ1c">const</span> <span class="ͼ18">sauces</span> = [<span class="ͼ1d">"Original BBQ"</span>, <span class="ͼ1d">"Honey BBQ"</span>, <span class="ͼ1d">"Smoked BBQ"</span>, <span class="ͼ1d">"Buffalo"</span>, <span class="ͼ1d">"Blazing Devil Spit"</span>, <span class="ͼ1d">"Garlic Parm"</span>, <span class="ͼ1d">"Ranch"</span>, <span class="ͼ1d">"Daddy Sauce"</span>];</div><div class="cm-line"><br></div><div class="cm-line"><span class="ͼ1c">export</span> <span class="ͼ1c">default</span> <span class="ͼ1c">function</span> <span class="ͼ18">ChefDaddyRaysWebsite</span>() {</div><div class="cm-gap" sty