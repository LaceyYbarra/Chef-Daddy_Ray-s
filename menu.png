<ul data-start="3854" data-end="3988">
<li data-section-id="bobehh" data-start="3854" data-end="3897">
<p data-start="3856" data-end="3897">🔥 “featured item at top” (big hero food)</p>
</li>
<li data-section-id="1onur3j" data-start="3898" data-end="3932">
<p data-start="3900" data-end="3932">🔥 animated glow on best sellers</p>
</li>
<li data-section-id="jay3jm" data-start="3933" data-end="3964">
<p data-start="3935" data-end="3964">🔥 combo images next to items</p>
</li>
<li data-section-id="5n25mn" data-start="3965" data-end="3988">
<p data-start="3967" data-end="3988">🔥 “order now” button</p>
</li>
</ul>
